# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash
# MOCK_AI=1                # dev only: canned AI output, no API calls
# LIMIT_DRAFT=10           # per IP per hour
# LIMIT_EDIT=60
# LIMIT_EXTRACT=40
# UPSTASH_REDIS_REST_URL=  # optional: shared rate limits across serverless instances
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_CONTRACT_MAINNET=0x...   # unset = app uses the testnet contract
